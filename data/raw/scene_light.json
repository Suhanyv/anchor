{
  "_about": "场景 → 光。从 11 条偏好记录里提炼的规则：光要和场景对上，不是越戏剧化越好。",
  "_why": "实测三条：深夜便利店选荧光灯（偏绿、频闪、廉价感），雨里选柔散光（大面积、无硬阴影），暖金配雨被判为矛盾。也就是说判断依据是「这个场景的光是什么样」，不是「哪种光更好看」。",
  "_usage": "按顺序匹配，命中就定光。显式「光用X」优先于本表。",
  "rules": [
    { "when": ["便利店", "超市", "货架", "值夜", "收银"], "light": "荧光灯",
      "note": "便利店永远是荧光灯，冷白偏绿、频闪、廉价" },
    { "when": ["医院", "急诊", "病房", "诊室", "手术"], "light": "荧光灯" },
    { "when": ["办公室", "教室", "走廊", "电梯", "地铁", "停车场"], "light": "荧光灯" },

    { "when": ["雨", "下雨", "雨中", "雨里", "下雨天"], "light": "雨天光" },
    { "when": ["雪天", "下雪", "雪地", "雪原", "雪中"], "light": "雪天光" },
    { "when": ["沙尘", "风沙", "沙漠", "戈壁", "黄土"], "light": "沙尘光" },
    { "when": ["星空", "银河", "夜空", "星野"], "light": "星空夜" },
    { "when": ["雾", "雾天", "大雾"], "light": "雾气漫射" },

    { "when": ["烛", "蜡烛", "灯火"], "light": "烛光" },
    { "when": ["火把", "篝火", "火堆", "燃烧"], "light": "火光" },
    { "when": ["黄昏", "夕阳", "落日", "傍晚"], "light": "黄昏侧光" },
    { "when": ["蓝调", "入夜", "天将黑", "天刚黑"], "light": "蓝调时刻" },
    { "when": ["月光", "月夜", "月亮"], "light": "月光" },

    { "when": ["教堂", "寺院", "庙", "神殿", "礼拜"], "light": "光柱",
      "note": "宗教空间靠光柱与尘埃，不靠均匀照明" },
    { "when": ["舞台", "演出", "聚光", "擂台"], "light": "单点光" },
    { "when": ["地下室", "隧道", "仓库", "地窖", "牢房"], "light": "单点光" },

    { "when": ["卧室", "床上", "床头", "公寓", "客厅", "厨房"], "light": "实用光",
      "note": "室内夜戏用画面内的实用光源（台灯、电视、冰箱缝）" },
    { "when": ["酒吧", "霓虹", "夜店", "街灯", "招牌"], "light": "实用光" }
  ]
}
